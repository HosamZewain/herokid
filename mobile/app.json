{
  "expo": {
    "name": "HeroKid",
    "slug": "herokid",
    "scheme": "herokid",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": "يسمح HeroKid بحفظ بطاقة هوية طفلك على جهازك بعد طلبك.",
          "savePhotosPermission": "يسمح HeroKid بحفظ بطاقة هوية طفلك على جهازك بعد طلبك.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم HeroKid الصور التي تختارها فقط لإنشاء هوية ومنتجات طفلك بعد موافقتك.",
          "cameraPermission": "يستخدم HeroKid الكاميرا لالتقاط صور طفلك التي تختار إضافتها.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.herokid.app",
      "associatedDomains": ["applinks:hero-kid.com"],
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.herokid.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#4F46E5"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "hero-kid.com", "pathPrefix": "/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "SET_WITH_EAS_INIT"
      }
    }
  }
}
