# Merge with a secured final Hostinger env copy. Do not source this file in a shell.
# Preserve production APP_KEY and existing integration credentials; never reuse staging APP_KEY.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hero-kid.com
DB_DATABASE=herokid
PRIVATE_MEDIA_DISK=s3_private
PUBLIC_MEDIA_DISK=public
PROCESSING_DISK=local
STORY_LIBRARY_DISK=s3_private
STUDIO_PRIVATE_DRIVER=scoped
EXPENSES_MEDIA_DISK=local
AWS_BUCKET=herokid-prod-media-2026
AWS_DEFAULT_REGION=eu-central-1
AWS_EC2_METADATA_DISABLED=false
QUEUE_CONNECTION=redis
PUBLIC_IMAGES_QUEUE_CONNECTION=redis
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=herokid_production_
REDIS_QUEUE_RETRY_AFTER=960
DB_QUEUE_RETRY_AFTER=960
SESSION_SECURE_COOKIE=true
# Remove static AWS credentials. Enable external integrations only at the approved cutover gate.
