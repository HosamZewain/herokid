# Prepared only. Install/enable after explicit release and activation approval.
[Unit]
Description=HeroKid Auto Pilot shadow decision worker
After=network.target redis-server.service mysql.service
ConditionPathIsSocket=/run/herokid-autopilot/decision.sock

[Service]
Type=simple
User=herokid-autopilot-worker
Group=herokid-autopilot
SupplementaryGroups=www-data
WorkingDirectory=/var/www/herokid
ExecStartPre=/usr/bin/test -r /var/www/herokid/bootstrap/cache/config.php
ExecStart=/usr/bin/php /var/www/herokid/ops/agentic/deploy/worker.php queue:work agentic-shadow --queue=agentic-shadow --sleep=3 --tries=1 --timeout=1000 --memory=256
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=1100
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/herokid/storage/logs /var/www/herokid/storage/framework
UMask=0077
MemoryMax=384M
TasksMax=32

[Install]
WantedBy=multi-user.target
